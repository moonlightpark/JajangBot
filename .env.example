# Comma list of coins. Traded as Bybit USDT linear perps (BTCUSDT, ...).
COINS=BTC,ETH,SOL,DOGE,BNB
# Decision + requote cadence. Jev picks leverage, open/close/hold, and long/short.
TICK_MS=2000
# Chart and mid prints. Does not call Jev.
PRICE_MS=200
# Days of 15m candles loaded at start. The 15m and 1H chart views reach back this far.
CHART_DAYS=92
# Quote notional per tick, raised to the Bybit minimum order size. Position cap is MAX_POSITION_USD below.
QUOTE_USD=40
QUOTE_INSIDE_TICKS=1
# How far an exit crosses the touch. Closes are IOC takers, not resting quotes.
CLOSE_SLIPPAGE_BPS=5
# Dry run starting balance in USD, all coins together, split evenly. With keys the Bybit balance is used.
BANKROLL_USD=500
# Risk caps. Empty or 0 means no cap.
# MAX_POSITION_USD: max open notional per coin. An open that would grow past it sends no order.
MAX_POSITION_USD=
# MAX_LEVERAGE: ceiling on the leverage Jev can pick, below the coin max (e.g. 5).
MAX_LEVERAGE=
HORIZON_BLOCKS=100

# Bybit environment: demo (default, mainnet prices, virtual funds) | testnet | mainnet (real funds)
BYBIT_ENV=demo
# A coin with no key is a dry run: real book, real decisions, simulated fills.
# DRY_RUN=true forces simulated quotes even when keys are set.
DRY_RUN=false
# Sub-account API key for the first coin (BTC). Never grant withdrawal permission.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Other coins: put keys in .bybit-keys.json (gitignored),
# or set BYBIT_KEYS_JSON={"sleeves":[{"coin":"ETH","apiKey":"...","apiSecret":"..."}]}
BYBIT_KEYS_JSON=

# Who decides: mock (default) | jev | strategy
#   mock     = momentum stand-in, no API key
#   jev      = Jev decides (TYPESAFE_API_KEY or AI_GATEWAY_API_KEY)
#   strategy = user strategy: TradingView "Maginga 15Ho" EMA(125) channel rules on 15m candles (src/strategy.ts)
MODEL=mock
# MODEL=strategy: entry leverage (the script's labels say x3)
STRATEGY_LEVERAGE=3
# MODEL=strategy variant. Empty means the script as written. Compare variants with `bun run sweep`.
# EMA length (script: 125)
STRATEGY_EMA_LEN=
# Stop loss, percent against the entry (script: none)
STRATEGY_STOP_PCT=
# Exit: opposite (far line, script) or mid (channel middle)
STRATEGY_EXIT=
# true: decide on the last closed 15m bar (script: the forming bar every tick)
STRATEGY_ON_BAR_CLOSE=
# true: take profit as soon as the tick price reaches the far line, without waiting for a bar close
STRATEGY_EXIT_LIVE=
# true: once the last add is in, stop when the price breaks the low (long) / high (short) between the last two entries
STRATEGY_SWING_STOP=
# Once every entry is in (1 + STRATEGY_MAX_ADDS), take this share when the price gets back to the first entry's price: 2/3, or a percent (empty: off)
STRATEGY_FIRST_PRICE_TP=
# After that take profit the rest counts as entry 1. Once the next entry (entry 2) is in, take this share when the price gets back to the price that take profit closed at: 50, or 1/2 (empty: off)
STRATEGY_RETAKE_TP=
# Partial take profit: this percent of the position once the price reaches the channel middle, after the first entry only (empty: off)
STRATEGY_PARTIAL_TP_PCT=
# Adds (물타기) after the first entry, same side, on the strategy's own entry signal (script: 0, none)
STRATEGY_MAX_ADDS=
# 15m bars after the last entry before each add, comma separated per add: 50,70 = entry 2 after 50, entry 3 after 70 (default 50 for every add)
STRATEGY_ADD_GAP_BARS=
# How Jev is called when MODEL=jev.
# typesafe = official TypeSafe API (https://docs.typesafe.ai/)
# gateway  = Vercel AI Gateway
# Unset: TypeSafe if TYPESAFE_API_KEY is set, else Gateway if AI_GATEWAY_API_KEY is set.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# Model id. Defaults: jev-latest (typesafe), typesafe-ai/jev (gateway)
JEV_MODEL_ID=
# Gateway option. Set JEV_PROVIDER=gateway and fill this instead.
AI_GATEWAY_API_KEY=

# Bot SSE on 3000. Dashboard Next in web/ uses 3001.
PORT=3000
# Interface to bind. On a server behind nginx, set 127.0.0.1.
HOST=0.0.0.0
